# Copy this file to .env or export the variables in your shell.
# Do not commit real API keys or private model paths.

GPT_API_KEY=
GPT_API_URL=https://api.xty.app/v1/chat/completions
GPT_MODEL=gpt-5.4

GEMMA_MODEL_PATH=/path/to/google/gemma-2-2b
GEMMA9B_MODEL_PATH=/path/to/google/gemma-2-9b
QWEN3_4B_MODEL_PATH=/path/to/Qwen3-4B-Base

CSV_RETRIEVED_DIR=/path/to/rag-probe/results/csv_retrieved_qwen3_4b_best_for_pipeline
DOLA_CUSTOM_GENERATE=/path/to/rag-probe/third_party/transformers-community-dola/custom_generate/generate.py

HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
OMP_NUM_THREADS=1
